# 1. 全局默认：自动检测文本/二进制，并规范化换行符
* text=auto

# 2. 强制以下文本文件使用 LF（跨平台兼容）
*.gradle           text eol=lf
*.kt               text eol=lf
*.kts              text eol=lf
*.java             text eol=lf
*.py               text eol=lf
*.sh               text eol=lf
*.bash             text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.properties       text eol=lf
*.xml              text eol=lf
*.html             text eol=lf
*.htm              text eol=lf
*.css              text eol=lf
*.scss             text eol=lf
*.js               text eol=lf
*.jsx              text eol=lf
*.ts               text eol=lf
*.tsx              text eol=lf
*.json             text eol=lf
*.md               text eol=lf
*.txt              text eol=lf
Dockerfile         text eol=lf
Makefile           text eol=lf
gradlew            text eol=lf   # Unix 执行脚本

# 3. Windows 批处理必须保留 CRLF
*.bat              text eol=crlf
*.cmd              text eol=crlf
gradlew.bat        text eol=crlf

# 4. 二进制文件：不做换行转换（避免损坏）
*.jar              binary
*.war              binary
*.ear              binary
*.zip              binary
*.tar              binary
*.gz               binary
*.png              binary
*.jpg              binary
*.jpeg             binary
*.gif              binary
*.ico              binary
*.bmp              binary
*.svg              binary           # 矢量图虽然是文本，但通常按二进制处理更安全
*.ttf              binary
*.woff             binary
*.woff2            binary
*.eot              binary
*.otf              binary
*.pdf              binary
*.docx             binary
*.xlsx             binary
*.pptx             binary
*.db               binary
*.lock             binary           # 依赖锁文件通常不参与 diff
*.so               binary
*.dll              binary
*.exe              binary
*.dylib            binary
*.o                binary
*.a                binary
*.pyc              binary
*.class            binary           # Java/Kotlin 字节码
*.keystore         binary
*.jks              binary

# 5. 特殊文件：某些文件即使内容相似，也不做换行规范化（比如 .gitattributes 自身）
# 但通常无需特别设置，因为 text=auto 已经足够
